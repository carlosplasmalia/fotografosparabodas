---
const destinations = [
  { name: 'Málaga · Costa del Sol',  slug: 'malaga' },
  { name: 'Mallorca',                slug: 'mallorca' },
  { name: 'Barcelona · Costa Brava', slug: 'barcelona' },
];
---

<footer class="bg-[#1C1814] text-[#C4A5A0]">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <div>
        <p class="font-['Cormorant_Garamond'] text-2xl font-semibold text-white mb-4">
          Wedding Photographers Spain
        </p>
        <p class="text-sm leading-relaxed text-[#9A8880] max-w-xs">
          Handpicked wedding photographers for couples getting married in Spain. Every wedding gets the eye it deserves.
        </p>
      </div>

      <div>
        <p class="font-['Lato'] text-xs font-bold tracking-widest uppercase text-[#C4A5A0] mb-5">
          Destinations
        </p>
        <ul class="space-y-2">
          {destinations.map(d => (
            <li>
              <a href={`/en/${d.slug}/`}
                class="text-sm text-[#9A8880] hover:text-white transition-colors">
                Wedding photographers in {d.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-['Lato'] text-xs font-bold tracking-widest uppercase text-[#C4A5A0] mb-5">
          Guides
        </p>
        <ul class="space-y-2 mb-6">
          <li><a href="/en/style/mediterranean/" class="text-sm text-[#9A8880] hover:text-white transition-colors">Mediterranean wedding photography style</a></li>
          <li><a href="/en/blog/destination-wedding-spain-guide/" class="text-sm text-[#9A8880] hover:text-white transition-colors">Destination wedding in Spain, the full guide</a></li>
        </ul>
        <p class="font-['Lato'] text-xs font-bold tracking-widest uppercase text-[#C4A5A0] mb-3">
          Language
        </p>
        <ul class="space-y-2">
          <li><a href="/" hreflang="es" class="text-sm text-[#9A8880] hover:text-white transition-colors">Español (España)</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#3A2E28] mt-12 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="text-xs text-[#6B5E58]">
        © 2026 Wedding Photographers Spain. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/en/blog/destination-wedding-spain-guide/" class="text-xs text-[#6B5E58] hover:text-white transition-colors">Guide</a>
        <a href="/aviso-legal/" class="text-xs text-[#6B5E58] hover:text-white transition-colors">Legal</a>
        <a href="/privacidad/" class="text-xs text-[#6B5E58] hover:text-white transition-colors">Privacy</a>
      </div>
    </div>
  </div>
</footer>
