---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const destinations = [
  { name: 'Málaga · Costa del Sol',  slug: 'malaga' },
  { name: 'Mallorca',                slug: 'mallorca' },
  { name: 'Barcelona · Costa Brava', slug: 'barcelona' },
];
---

<header
  id="site-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    transparent ? 'bg-transparent' : 'bg-[#FAF7F2] shadow-sm border-b border-[#E8DDD3]',
  ]}
  data-transparent={transparent ? 'true' : undefined}
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">

      <a href="/en/" class="shrink-0">
        <span
          class="font-['Cormorant_Garamond'] text-xl font-semibold tracking-wide transition-colors"
          style={transparent ? 'color:#fff' : 'color:#1C1814'}
        >
          Wedding Photographers Spain
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-0.5">

        <div class="relative group">
          <button
            class="flex items-center gap-1 text-sm font-['Lato'] font-medium px-3 py-2 rounded transition-colors hover:bg-black/5"
            style={transparent ? 'color:rgba(255,255,255,0.85)' : 'color:#1C1814'}
          >
            Destinations
            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            <div class="bg-white border border-[#E8DDD3] rounded-sm shadow-xl shadow-black/10 w-72 p-2">
              <p class="font-['Lato'] text-[10px] font-bold tracking-widest uppercase text-[#8B6A3A] px-3 py-2">
                Destination weddings in Spain
              </p>
              {destinations.map(d => (
                <a
                  href={`/en/${d.slug}/`}
                  class="block px-3 py-2 rounded hover:bg-[#FAF7F2] transition-colors font-['Lato'] text-sm font-medium text-[#1C1814]"
                >
                  {d.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href="/en/style/mediterranean/"
          class="text-sm font-['Lato'] font-medium px-3 py-2 rounded transition-colors hover:bg-black/5"
          style={transparent ? 'color:rgba(255,255,255,0.85)' : 'color:#1C1814'}
        >
          Mediterranean style
        </a>

        <a
          href="/en/blog/destination-wedding-spain-guide/"
          class="text-sm font-['Lato'] font-medium px-3 py-2 rounded transition-colors hover:bg-black/5"
          style={transparent ? 'color:rgba(255,255,255,0.85)' : 'color:#1C1814'}
        >
          Guide
        </a>

        <a
          href="/"
          hreflang="es"
          class="text-sm font-['Lato'] font-medium px-3 py-2 rounded transition-colors hover:bg-black/5"
          style={transparent ? 'color:rgba(255,255,255,0.85)' : 'color:#6B5E58'}
        >
          ES
        </a>
      </nav>

      <a
        href="#contact"
        class:list={[
          'hidden sm:inline-block text-sm font-["Lato"] font-medium px-4 py-2 rounded transition-colors',
          transparent
            ? 'bg-white text-[#1C1814] hover:bg-[#F2E8D5]'
            : 'bg-[#8B6A3A] text-white hover:bg-[#7a5c32]',
        ]}
      >
        Enquire
      </a>

      <button id="mobile-menu-toggle" class="lg:hidden p-2" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style={transparent ? 'color:#fff' : 'color:#1C1814'}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pb-4 space-y-3">
      <div class="border-t border-[#E8DDD3] pt-3 space-y-1">
        {destinations.map(d => (
          <a href={`/en/${d.slug}/`} class="block font-['Lato'] text-sm text-[#1C1814] px-2 py-1.5 hover:bg-[#F2E8D5] rounded">{d.name}</a>
        ))}
      </div>
      <div class="border-t border-[#E8DDD3] pt-3 space-y-1">
        <a href="/en/style/mediterranean/" class="block font-['Lato'] text-sm text-[#1C1814] px-2 py-1.5 hover:bg-[#F2E8D5] rounded">Mediterranean style</a>
        <a href="/en/blog/destination-wedding-spain-guide/" class="block font-['Lato'] text-sm text-[#1C1814] px-2 py-1.5 hover:bg-[#F2E8D5] rounded">Destination wedding guide</a>
        <a href="/" class="block font-['Lato'] text-sm text-[#6B5E58] px-2 py-1.5 hover:bg-[#F2E8D5] rounded">Español →</a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
