          target="_blank" rel="noopener noreferrer"
          class="btn-gold text-sm py-2.5 px-5"
        >
          Write on WhatsApp
        </a>
      </div>

      <div class="mt-14 pt-10 border-t border-[#E8DDD3]">
        <p class="section-eyebrow mb-6">Read next</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="/en/style/mediterranean/" class="group bg-white border border-[#E8DDD3] rounded-sm p-5 hover:shadow-md transition-shadow">
            <h3 class="font-['Cormorant_Garamond'] text-xl font-semibold text-[#1C1814] group-hover:text-[#8B6A3A] transition-colors">Mediterranean wedding photography</h3>
            <p class="font-['Lato'] text-xs text-[#6B5E58] mt-2">What the style is, and how to spot the difference between real and imitation.</p>
          </a>
          <a href="/en/" class="group bg-white border border-[#E8DDD3] rounded-sm p-5 hover:shadow-md transition-shadow">
            <h3 class="font-['Cormorant_Garamond'] text-xl font-semibold text-[#1C1814] group-hover:text-[#8B6A3A] transition-colors">Destinations we cover</h3>
            <p class="font-['Lato'] text-xs text-[#6B5E58] mt-2">Málaga, Mallorca, Barcelona, Granada, Seville, Tenerife.</p>
          </a>
        </div>
      </div>
    </div>

  </main>
  <SiteFooterEn />
</BaseLayout>

