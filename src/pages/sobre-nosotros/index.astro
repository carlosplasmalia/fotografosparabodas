---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { site, cities } from '../../config/site';

const totalCiudades = cities.length;
---

<BaseLayout
  title="Sobre nosotros — Fotógrafos para Bodas"
  description="Quiénes somos, cómo elegimos a los fotógrafos que aparecen aquí y cómo se financia este sitio. Sin letra pequeña."
  canonical={`https://${site.domain}/sobre-nosotros/`}
  noindex={false}
>
  <SiteHeader />
  <main class="pt-16">

    <!-- Hero -->
    <section class="bg-[#1C1814] py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="font-['Lato'] text-xs font-bold tracking-widest uppercase text-[#8B6A3A] mb-6">
          Sobre nosotros
        </p>
        <h1 class="font-['Cormorant_Garamond'] text-5xl md:text-6xl font-semibold text-white leading-tight mb-6">
          Quiénes somos y<br/>
          <em class="text-[#8B6A3A] not-italic">cómo elegimos a los fotógrafos</em>
        </h1>
        <p class="font-['Lato'] text-[#9A8880] text-lg leading-relaxed">
          Fotógrafos para Bodas es un directorio independiente de fotógrafos de boda en España. Reunimos el trabajo público de cada profesional para que puedas comparar sin abrir veinte pestañas.
        </p>
      </div>
    </section>

    <!-- Qué hacemos -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-eyebrow mb-4">Qué hacemos</p>
        <h2 class="section-title mb-6">Comparativas por ciudad y por estilo</h2>
        <span class="gold-divider mb-8"></span>
        <p class="font-['Lato'] text-[#1C1814] leading-relaxed mb-4">
          Publicamos guías por ciudad y por estilo de fotografía. En cada una encontrarás fotógrafos reales con su web, Instagram, portfolio y zona de trabajo. Cubrimos hoy {totalCiudades} ciudades españolas y los principales estilos de fotografía de boda: documental, editorial, romántico, mediterráneo y clásico.
        </p>
        <p class="font-['Lato'] text-[#6B5E58] leading-relaxed">
          No pretendemos ser exhaustivos. Preferimos una selección corta y honesta a un listado infinito donde ya nadie destaca.
        </p>
      </div>
    </section>

    <!-- Quién está detrás -->
    <section class="py-20 bg-[#FAF7F2]">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-eyebrow mb-4">Quién hay detrás</p>
        <h2 class="section-title mb-6">Un ojo entrenado en el sector</h2>
        <span class="gold-divider mb-8"></span>
        <p class="font-['Lato'] text-[#1C1814] leading-relaxed mb-4">
          Detrás de este proyecto hay alguien que lleva años dentro de la industria audiovisual de bodas y eventos. He trabajado con fotógrafos y videógrafos de primer nivel en España, conozco cómo se produce una boda desde dentro y sé distinguir un portfolio pulido de un trabajo realmente sólido.
        </p>
        <p class="font-['Lato'] text-[#6B5E58] leading-relaxed">
          Ese criterio es lo que aplico al mirar cada web, cada Instagram y cada reportaje antes de incluir a un fotógrafo aquí. No es una lista automática: es una selección hecha con conocimiento de causa.
        </p>
      </div>
    </section>

    <!-- Cómo elegimos -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <div class="mb-14">
          <p class="section-eyebrow mb-4">Cómo elaboramos las comparativas</p>
          <h2 class="section-title mb-6">Criterio, no algoritmo</h2>
          <span class="gold-divider"></span>
        </div>

        <div class="space-y-6">
          {[
            {
              t: 'Partimos del trabajo público',
              d: 'Revisamos portfolio, web y redes sociales de cada fotógrafo. Miramos bodas reales, no sesiones de estilismo. No inventamos ni un dato: si algo aparece aquí es porque el fotógrafo lo tiene publicado en su web o en sus perfiles.',
            },
            {
              t: 'Filtramos por nivel real',
              d: 'Priorizamos fotógrafos con trayectoria contrastada, estilo propio reconocible y coherencia entre lo que muestran y lo que entregan. Un portfolio con dos bodas perfectas dice menos que veinte bodas con nivel homogéneo.',
            },
            {
              t: 'Comprobamos la cobertura',
              d: 'Solo incluimos a un fotógrafo en la ciudad donde realmente trabaja, no donde le pilla cerca. Si opera en toda España, lo indicamos como fotógrafo de destino.',
            },
            {
              t: 'Revisamos periódicamente',
              d: 'Los fotógrafos evolucionan, cambian de web o dejan la profesión. Revisamos las fichas cada cierto tiempo y corregimos lo que detectamos o lo que nos comunican.',
            },
          ].map(item => (
            <div class="bg-[#FAF7F2] border border-[#E8DDD3] rounded-sm p-6">
              <h3 class="font-['Cormorant_Garamond'] text-2xl font-semibold text-[#1C1814] mb-2">{item.t}</h3>
              <p class="font-['Lato'] text-sm text-[#6B5E58] leading-relaxed">{item.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Qué no hacemos -->
    <section class="py-20 bg-[#FAF7F2]">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-eyebrow mb-4">Qué no hacemos</p>
        <h2 class="section-title mb-6">Los límites, por escrito</h2>
        <span class="gold-divider mb-10"></span>

        <ul class="space-y-6">
          {[
            {
              t: 'No prestamos servicios de fotografía',
              d: 'No somos un estudio ni una agencia de fotógrafos en plantilla. No formamos parte del contrato entre tú y el fotógrafo que finalmente elijas.',
            },
            {
              t: 'No cobramos al usuario',
              d: 'Consultar las comparativas, pedir asesoramiento y contactar con un fotógrafo a través nuestro es gratis, siempre.',
            },
            {
              t: 'No verificamos licencias, seguros ni contratos',
              d: 'Mostramos trabajo público y criterio profesional; no sustituye tus propias comprobaciones. Pide siempre presupuesto por escrito, contrato firmado y factura.',
            },
            {
              t: 'No publicamos reseñas propias',
              d: 'Las valoraciones y comentarios que puedas ver proceden de fuentes públicas del propio fotógrafo o de Google. No nos inventamos testimonios.',
            },
          ].map(item => (
            <li class="flex items-start gap-4">
              <span class="text-[#8B6A3A] font-bold mt-1">—</span>
              <div>
                <p class="font-['Cormorant_Garamond'] text-xl font-semibold text-[#1C1814] mb-1">{item.t}</p>
                <p class="font-['Lato'] text-sm text-[#6B5E58] leading-relaxed">{item.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Cómo se financia -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-eyebrow mb-4">Cómo se financia este sitio</p>
        <h2 class="section-title mb-6">Transparencia, sin trucos</h2>
        <span class="gold-divider mb-8"></span>
        <p class="font-['Lato'] text-[#1C1814] leading-relaxed mb-4">
          Hoy ningún fotógrafo paga por aparecer en las comparativas: la selección se basa en el nivel del trabajo. Nuestro modelo es cobrar a los fotógrafos únicamente por las solicitudes de presupuesto reales que les hacemos llegar, nunca al usuario.
        </p>
        <p class="font-['Lato'] text-[#6B5E58] leading-relaxed">
          Si en el futuro incorporamos posiciones destacadas o patrocinadas, aparecerán marcadas de forma visible y separadas de la selección editorial. Si alguna vez ves una recomendación que no esté marcada, es porque no está pagada.
        </p>
      </div>
    </section>

    <!-- Correcciones -->
    <section class="py-20 bg-[#FAF7F2]">
      <div class="max-w-3xl mx-auto px-6">
        <p class="section-eyebrow mb-4">Correcciones y bajas</p>
        <h2 class="section-title mb-6">Si algo está mal, lo cambiamos</h2>
        <span class="gold-divider mb-8"></span>
        <p class="font-['Lato'] text-[#1C1814] leading-relaxed mb-4">
          Si tu estudio aparece en una comparativa y quieres corregir un dato, actualizar el enlace a tu web o solicitar la retirada de tu ficha, escríbenos a <a href={`mailto:${site.email}`} class="text-[#8B6A3A] underline">{site.email}</a> indicando el nombre del estudio y la página. Atendemos las solicitudes de baja sin pedir explicaciones.
        </p>
        <p class="font-['Lato'] text-[#6B5E58] leading-relaxed">
          Lo mismo si detectas un error en una URL, un estilo mal clasificado o una zona de trabajo desactualizada: avísanos y lo corregimos.
        </p>
      </div>
    </section>

    <!-- Contacto -->
    <section class="py-20 bg-[#1C1814]">
      <div class="max-w-xl mx-auto px-6 text-center">
        <p class="section-eyebrow text-[#8B6A3A] mb-4">Contacto</p>
        <h2 class="font-['Cormorant_Garamond'] text-4xl font-semibold text-white mb-4">
          Hablamos cuando quieras
        </h2>
        <span class="gold-divider"></span>
        <p class="font-['Lato'] text-[#9A8880] mt-6 mb-8 text-sm leading-relaxed">
          Escríbenos a <a href={`mailto:${site.email}`} class="text-white underline">{site.email}</a> o por WhatsApp. Contestamos personalmente.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={`https://wa.me/${site.whatsapp}?text=Hola%2C%20os%20escribo%20desde%20fotografosparabodas.es`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-gold inline-flex items-center justify-center gap-2 px-8 py-3"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            WhatsApp
          </a>
          <a
            href={`mailto:${site.email}`}
            class="border border-[#8B6A3A] text-[#8B6A3A] hover:bg-[#8B6A3A] hover:text-white transition-colors font-['Lato'] text-sm font-semibold tracking-wider uppercase inline-flex items-center justify-center px-8 py-3"
          >
            Enviar email
          </a>
        </div>
      </div>
    </section>

  </main>
  <SiteFooter />
</BaseLayout>
